{
 "log_files":["/var/log/nginx/access.log","/var/log/auth.log"],
 "threshold":8,"window_seconds":300,"block_time":"1h",
 "allowlist":["127.0.0.1/32","192.168.0.0/16","10.0.0.0/8"],
 "suspicious_patterns":[" 401 "," 403 "," 404 "," 429 "," 444 ","failed password","invalid user","authentication failure","login failed","wp-login","xmlrpc.php"],
 "ip_regex":["(?P<ip>[0-9]{1,3}(?:[.][0-9]{1,3}){3})"],
 "nft_set":"dynamic_blacklist","iptables_chain":"DYNAMIC_BLACKLIST","windows_rule_prefix":"DynamicBlacklist"
}
