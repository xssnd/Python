{
  "settings": {
    "interval_seconds": 10,
    "restart_cooldown_seconds": 60,
    "max_restart_attempts": 3,
    "retry_window_seconds": 300,
    "recovery_notifications": true,
    "log_file": "process_watcher.log"
  },
  "processes": [
    {
      "name": "Nginx",
      "match": ["nginx"],
      "restart_command": ["sudo", "-n", "systemctl", "restart", "nginx"],
      "restart_timeout_seconds": 30
    },
    {
      "name": "MySQL",
      "match": ["mysqld", "mariadbd"],
      "restart_command": ["sudo", "-n", "systemctl", "restart", "mysql"],
      "restart_timeout_seconds": 45
    }
  ],
  "notifications": {
    "telegram": {"bot_token": "", "chat_id": ""},
    "discord": {"webhook_url": ""},
    "email": {"host": "", "port": 587, "username": "", "password": "", "from": "", "to": ""}
  }
}
